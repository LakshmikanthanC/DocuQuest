# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Default account (created automatically on startup) ----
# Change the password before exposing the app.
SEED_DEFAULT_USER=true
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=admin12345
DEFAULT_USER_NAME=Admin

# ---- Ollama (LLM) ----
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=4096
# How long Ollama keeps the model in memory. Reloading costs seconds on CPU, so
# keep this well above the 5m default if you want consistently fast answers.
LLM_KEEP_ALIVE=30m
# Cap on generated tokens. Lower it to trade answer length for lower latency.
LLM_NUM_PREDICT=512

# ---- Embeddings ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- HTTP / CORS ----
# Comma-separated list of origins allowed to call this API. The default covers
# the local Next.js dev server. Set this to your deployed frontend origin or
# every browser request will be rejected as cross-origin.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Storage ----
# Defaults are resolved relative to the repository root.
# UPLOAD_DIRECTORY=./documents
# CHROMA_PERSIST_DIRECTORY=./backend/chroma_db

# ---- RAG tuning ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
MAX_UPLOAD_MB=25
# Relevance floor on the 0..1 similarity scale. Chunks below it are treated as
# no context and the LLM is never called, which is how unrelated questions are
# rejected. The scale is 1/(1 + squared_l2_distance), so it bottoms out near
# 0.33; a value below that can never reject anything. Lower it only if you have
# a corpus of long, topically similar documents.
MIN_RELEVANCE_SCORE=0.4
